ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://twin_user:twin_pass@postgres:5432/hospital_twin
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Enables POST /api/v1/assistant/ask (also needs `pip install -r requirements-assistant.txt`).
# Questions and aggregate results are sent to the model provider.
ANTHROPIC_API_KEY=
# Standalone AI module (/api/v1/ai/*, /api/v1/digital-twin/*): folder that CONTAINS ai_module/
# (empty = repo root; docker-compose sets it). The module reads its own AI_* variables, see
# ai_module/.env.example (e.g. AI_LLM_PROVIDER=none runs it without an LLM).
AI_MODULE_ROOT=
# ML model comparison (POST /api/v1/ml/analysis): "langflow" runs the Langflow flow through its API,
# "direct" runs the same ai_module.ml steps in-process (no Langflow server needed).
ML_ANALYSIS_MODE=langflow
LANGFLOW_URL=http://localhost:7860
# Langflow API key (Settings > API Keys in Langflow). Never commit a real one.
LANGFLOW_API_KEY=
# Flow id or endpoint name of the imported flow (langflow_integration/flows/ml_model_comparison.json)
LANGFLOW_FLOW_ID=ml-model-comparison
LANGFLOW_TIMEOUT_SECONDS=600
CORS_ORIGINS=["http://localhost:5173"]
