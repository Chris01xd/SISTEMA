# Copy to ai_module/.env (or export the variables). Every variable is optional.
# Point AI_ENV_FILE at another file to load settings from elsewhere.

# --- LLM (LangChain) ---------------------------------------------------------------
# anthropic | openai | ollama | ... (needs its langchain-<provider> package) | none (no LLM:
# deterministic answers; the digital twin, simulation and prediction still work)
AI_LLM_PROVIDER=anthropic
AI_LLM_MODEL=claude-sonnet-5
AI_LLM_TEMPERATURE=0
AI_LLM_TIMEOUT_SECONDS=60
AI_LLM_MAX_TOKENS=1500
AI_LLM_MAX_RETRIES=2
# e.g. Ollama or an OpenAI-compatible gateway:
# AI_LLM_BASE_URL=http://localhost:11434
# Leave empty to let the provider SDK read its own variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# When run through the backend, the backend's ANTHROPIC_API_KEY is reused if this is empty.
AI_LLM_API_KEY=

# --- LangGraph ---------------------------------------------------------------------
# Retries when the LLM writes numbers that are not present in the twin context.
AI_GRAPH_MAX_REGENERATIONS=1
AI_MAX_MESSAGE_CHARS=2000

# --- Digital twin assumptions (overridable per scenario) ------------------------------
AI_TWIN_BASELINE_DAILY_ADMISSIONS=20
# Empty = sized from the observed length of stay with Little's law at the target occupancy.
AI_TWIN_WARD_BEDS=
AI_TWIN_ICU_BEDS=
AI_TWIN_TARGET_OCCUPANCY=0.80
AI_TWIN_SIM_RUNS=100
AI_TWIN_SIM_HORIZON_HOURS=168
AI_TWIN_SIM_WARMUP_HOURS=720
AI_TWIN_RANDOM_SEED=42

# --- Storage / observability ----------------------------------------------------------
# AI_DATA_DIR=ai_module/data
# AI_ARTIFACTS_DIR=ai_module/artifacts
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true
